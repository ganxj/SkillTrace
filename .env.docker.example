# Browser-visible API address used by the Next.js admin frontend.
# If deploying on a server, change localhost to the server IP/domain.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# External PostgreSQL database used by the API.
DATABASE_URL=postgresql+psycopg://postgres:postgres@192.168.1.49:5432/ai_learning_os

# AI course generation. Leave AI_PROVIDER=mock if you only want the app to run
# without generating courses through a real model.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
